; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alchamess"
config/description="Alchamess combines simulation and puzzle-comedy, utilising potion-mixing and deduction in a Mastermind-style logic.  It also utilises a management/customer-service loop, similar to games like Potion Craft/Schedule 1-style, where you also utilise experimentation
"
run/main_scene="uid://cvlswtmdkf4hn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://dmrugnh5nj1ii"

[audio]

buses/default_bus_layout="uid://srgrt78o1d6n"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
Globals="*uid://coov8ubdpi33w"
PotionJournal="*uid://cqvvr3h2ffhx"

[dialogue_manager]

runtime/balloon_path="res://Assets/DialogueBalloons/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

