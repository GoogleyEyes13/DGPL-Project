# ==========================================
# Godot Engine Ignored Files
# ==========================================
# Godot 4.x & 3.x import directory (contains cached/imported assets)
.godot/
.import/

# Imported files where "keep import assets in SVN/Git" is disabled
*.import

# Exported build binaries & packages
*.apk
*.aab
*.a
*.ar
*.x86_64
*.x86
*.exe
*.dll
*.so
*.dylib
*.app
*.dmg
*.ipa
*.zip

# Translation binary files
*.translation

# Mono/C# project specific files (if using Godot C#)
.mono/
.vs/
.idea/
*.csproj
*.sln
*.generated.cs

# Visual Studio Code workspace configuration (optional - uncomment if preferred)
# .vscode/

# ==========================================
# macOS System & Temp Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride

# Icon files on macOS
Icon?

# Thumbnails & Metadata directories
._*
.Spotlight-V100
.Trashes

# Files created by macOS Finder
.fseventsd
.VolumeIcon.icns

# ==========================================
# Windows System & Temp Files
# ==========================================
# Windows Explorer Metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Folder customizations
Desktop.ini

# Windows Recycle Bin
$RECYCLE.BIN/

# Shortcut files
*.lnk

# Windows temporary crash dumps
*.stackdump
